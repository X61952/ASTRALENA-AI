{
  "name": "astralena",
  "version": "1.0.0",
  "description": "Astralena — an owner-first WhatsApp AI agent for space technology, full-stack development, research, files, GitHub, websites, and reminders.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node src/doctor.js",
    "setup": "node src/setup.js",
    "postinstall": "node -e \"require('child_process').spawn('npx',['playwright','install','--with-deps','chromium'],{stdio:'inherit',shell:true}).on('exit',()=>process.exit(0))\" || exit 0"
  },
  "dependencies": {
    "@codexverified/baileys": "2.18.18",
    "pino": "^8.17.2",
    "sharp": "^0.35.3",
    "playwright": "^1.49.0",
    "javascript-obfuscator": "^4.1.1",
    "adm-zip": "^0.5.16",
    "qrcode": "^1.5.4",
    "pdf-lib": "^1.17.1",
    "docx": "^9.6.1",
    "xlsx": "^0.18.5",
    "tesseract.js": "^7.0.0",
    "@napi-rs/canvas": "^0.1.53",
    "node-gtts": "^2.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.3.0"
  }
}
