# ── WhatsApp ────────────────────────────────────────────────
# The number Lexa LOGS IN as (her own WhatsApp number, digits only, with country code).
LEXA_PHONE=
# The ONLY number she listens to (you).
LEXA_OWNER_NUMBER=2349035671349
LEXA_NAME=Lexa
LEXA_CALLS_OWNER=codex
# Other names you can call her (comma separated). "Lexa" always works.
LEXA_ALIASES=alexa
# Listen to you in groups too (only you, and only when you call her by name, reply to her, or tag her):
LEXA_GROUPS=on

# ── Brain (required): OpenRouter and/or Groq ────────────────
# OpenRouter gives you any model (Claude, GPT, Gemini, Qwen, DeepSeek, Llama...). Groq is very fast and cheap.
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=openrouter
# The model MUST support tool calling. On openrouter.ai/models filter by "tools". Examples:
#   anthropic/claude-sonnet-4.5   openai/gpt-4o   google/gemini-2.5-flash
# For groq the default is llama-3.3-70b-versatile.
LLM_MODEL=
# Optional backup if the main model is down, rate-limited or out of credit (uses the other provider):
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.6

# ── Voice notes (speech-to-text): uses GROQ_API_KEY above (Whisper). ──
# OPENAI_API_KEY=
# STT_LANGUAGE=en

# Optional: a secret PIN for sensitive commands (default is the word "confirm")
# LEXA_SENSITIVE_PIN=

# ── Power ───────────────────────────────────────────────────────────────
# ask  = she asks before any command that isn't harmless read-only (safest, default)
# auto = she runs things herself and only asks for risky/destructive ones. Switch any time in chat: "mode auto" / "mode ask"
LEXA_AUTONOMY=ask
# Daily token budget (0 = unlimited). When reached she tells you and pauses until tomorrow.
LEXA_DAILY_TOKENS=3000000

# ── General ─────────────────────────────────────────────────
TIME_ZONE=Africa/Lagos
LEXA_WORKSPACE=./workspace
LEXA_DATA_DIR=./data

# ── Web search (use ONE; with none, she falls back to DuckDuckGo) ──
TAVILY_API_KEY=
BRAVE_API_KEY=

# ── GitHub (fine-grained token limited to YOUR repos: Contents + Pull requests: read/write) ──
GITHUB_TOKEN=
GIT_USER_NAME=Lexa
GIT_USER_EMAIL=lexa@example.com

# ── Your website (she controls it over SSH; every command needs your OK) ──
SITE_URL=https://codex-ai.site
SITE_SSH=            # user@host
SITE_SSH_KEY=        # path to a private key made just for Lexa
SITE_ROOT=           # folder of the site on the server, e.g. /var/www/codex-ai.site
